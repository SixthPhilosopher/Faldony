# deploy/.env.example — template for deploy/.env (read automatically by
# docker compose). Copy to .env, fill in real values, never commit .env.
#
# PostgreSQL password for the Faldony database user.
POSTGRES_PASSWORD=postgres
#
# Google OAuth2 client id (JWT `aud`, and the frontend's GIS client id).
# It is PUBLIC by design — it ships to the browser, so the placeholder below
# is not a secret; replace with a real client id created in Google Cloud
# Console (OAuth client, Web application) with an authorized JavaScript
# origin matching where the frontend is served (e.g. http://localhost:8080).
GOOGLE_CLIENT_ID=dummy
#
# OIDC issuer used for JWT validation/JWKS. MUST be Google's real endpoint —
# the backend only accepts tokens signed by Google and fails hard on others.
GOOGLE_ISSUER_URI=https://accounts.google.com
#
# Space/comma separated allow-list of Google identities that may use this
# archive. Canonical entries are Google `sub` values; entries containing '@'
# match the email claim (convenience — email can change, prefer subs).
# EMPTY LIST DENIES EVERYONE (fail closed): there is no dev bypass anymore.
FALDONY_AUTH_WHITELIST=